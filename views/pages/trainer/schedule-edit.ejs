<%- include('../../layouts/base-top', { title: title }) %>
<main class="container">
  <h1>Edit Schedule Slot</h1>
  <a href="/trainers/me/schedules" class="btn btn--secondary">← Back to Schedule</a>

  <section class="trainer-section">
    <form method="POST" action="/trainers/me/schedules/<%= schedule.id %>" class="form">
      <div class="form__group">
        <label for="day_of_week">Day of Week</label>
        <select id="day_of_week" name="day_of_week" required>
          <option value="mon" <%= schedule.day_of_week === 'mon' ? 'selected' : '' %>>Monday</option>
          <option value="tue" <%= schedule.day_of_week === 'tue' ? 'selected' : '' %>>Tuesday</option>
          <option value="wed" <%= schedule.day_of_week === 'wed' ? 'selected' : '' %>>Wednesday</option>
          <option value="thu" <%= schedule.day_of_week === 'thu' ? 'selected' : '' %>>Thursday</option>
          <option value="fri" <%= schedule.day_of_week === 'fri' ? 'selected' : '' %>>Friday</option>
          <option value="sat" <%= schedule.day_of_week === 'sat' ? 'selected' : '' %>>Saturday</option>
          <option value="sun" <%= schedule.day_of_week === 'sun' ? 'selected' : '' %>>Sunday</option>
        </select>
      </div>
      <div class="form__group">
        <label for="start_time">Start Time</label>
        <input type="time" id="start_time" name="start_time" value="<%= schedule.start_time.substring(0, 5) %>" required>
      </div>
      <div class="form__group">
        <label for="end_time">End Time</label>
        <input type="time" id="end_time" name="end_time" value="<%= schedule.end_time.substring(0, 5) %>" required>
      </div>
      <div class="form__group">
        <label for="session_type">Session Type</label>
        <select id="session_type" name="session_type" required>
          <option value="individual" <%= schedule.session_type === 'individual' ? 'selected' : '' %>>Individual</option>
          <option value="group" <%= schedule.session_type === 'group' ? 'selected' : '' %>>Group</option>
          <option value="semi_private" <%= schedule.session_type === 'semi_private' ? 'selected' : '' %>>Semi-Private</option>
        </select>
      </div>
      <div class="form__group">
        <label for="capacity">Capacity</label>
        <input type="number" id="capacity" name="capacity" min="1" value="<%= schedule.capacity %>" required>
      </div>
      <div class="form__group">
        <label for="per_session_rate">Per-Session Rate Override (optional, $)</label>
        <input type="number" id="per_session_rate" name="per_session_rate" min="0" step="0.01"
          value="<%= (schedule.per_session_rate !== null && schedule.per_session_rate !== undefined) ? parseFloat(schedule.per_session_rate).toFixed(2) : '' %>"
          placeholder="Leave blank to use your default rate">
      </div>
      <button type="submit" class="btn btn--primary">Save Changes</button>
    </form>
  </section>
</main>
<%- include('../../layouts/base-bottom') %>
