<%- include('../../layouts/base-top', { title: title }) %>
<main class="container">
  <h1>My Gym Subscriptions</h1>

  <% if (gymSubscriptions.length === 0) { %>
    <p class="text--muted">No gym subscriptions yet.</p>
    <a href="/gyms" class="btn btn--primary">Browse Gyms</a>
  <% } else { %>
    <ul class="subscription-list">
      <% gymSubscriptions.forEach(function(gs) { %>
        <li class="subscription-item">
          <div class="subscription-item__gym">
            <a href="/gyms/<%= gs.gym_id %>">
              <%= gs.gym_name %>
            </a>
          </div>
          <span class="status-badge status-badge--<%= gs.status %>">
            <%= gs.status.charAt(0).toUpperCase() + gs.status.slice(1) %>
          </span>
          <div class="text--muted">Subscribed: <%= new Date(gs.subscribed_at).toLocaleDateString() %></div>
          <% if (gs.status === 'active') { %>
            <form method="POST" action="/gym-subscriptions/<%= gs.id %>/cancel">
              <button type="submit" class="btn btn--danger">Cancel Subscription</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</main>
<%- include('../../layouts/base-bottom') %>
