<%- include('../../layouts/base-top', { title: title }) %>
<main class="container">
  <h1>My Waitlist</h1>
  <a href="/auth/student-dashboard" class="btn btn--secondary">← Back to Dashboard</a>

  <% if (entries.length === 0) { %>
    <p class="text--muted">You are not on any waitlists.</p>
  <% } else { %>
    <ul class="waitlist-list">
      <% entries.forEach(function(entry) { %>
        <li class="waitlist-item">
          <strong><%= new Date(entry.session_date).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %></strong>
          — <%= entry.start_time.substring(0, 5) %> to <%= entry.end_time.substring(0, 5) %><br>
          Trainer: <%= entry.trainer_first_name %> <%= entry.trainer_last_name %><br>
          Type: <%= entry.session_type %> |
          Queue position: #<%= entry.position %> |
          Status: <span class="status-badge status-badge--<%= entry.status %>"><%= entry.status %></span>
          <% if (entry.status === 'offered') { %>
            <p class="text--warning">
              Claim window open — expires
              <%= new Date(entry.claim_expires_at).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC' }) %> UTC
            </p>
            <form method="POST" action="/waitlist/<%= entry.id %>/claim" style="display:inline-block;">
              <button type="submit" class="btn btn--primary btn--sm">Claim Slot</button>
            </form>
          <% } else if (entry.status === 'waiting') { %>
            <form method="POST" action="/waitlist/<%= entry.id %>/leave"
                  style="display:inline-block; margin-left: 1rem;"
                  onsubmit="return confirm('Leave this waitlist?')">
              <button type="submit" class="btn btn--danger btn--sm">Leave Waitlist</button>
            </form>
          <% } %>
        </li>
      <% }) %>
    </ul>
  <% } %>
</main>
<%- include('../../layouts/base-bottom') %>
